[Unit]
Description=wadamesh tile transcode service (OSM PNG -> JPEG for touch firmware)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wadamesh-tiles
# The system python, with flask/pillow/requests from apt. There is no venv on
# the box and systemd does not fall back, so this must name a real interpreter:
# the repo said venv for months while the live unit said this. Corrected to what
# actually runs.
ExecStart=/usr/bin/python3 /opt/wadamesh-tiles/tile-transcode.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
