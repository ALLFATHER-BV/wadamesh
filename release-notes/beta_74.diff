-  if (!(ndx_ == -dx_ && ndy_ == -dy_)) { dx_ = ndx_; dy_ = ndy_; }
-  const int nx = bx_[0] + dx_, ny = by_[0] + dy_;
-  const bool eat = (nx == fx_ && ny == fy_);
